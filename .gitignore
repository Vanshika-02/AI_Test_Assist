# Environment variables - NEVER COMMIT!
.env
.env.local
.env.*.local
**/.env
my-fastapi-project/.env

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.so
.Python

# Virtual Environment - NEVER COMMIT!
venv/
env/
ENV/
.venv/
my-fastapi-project/venv/

# Logs
*.log
Logs/
my-fastapi-project/Logs/

# Database files
*.db
*.sqlite
*.sqlite3

# ChromaDB
chromadb_data/
my-fastapi-project/chromadb_data/

# Generated files
Generated_Scripts/
my-fastapi-project/Generated_Scripts/

# Data files
data/
my-fastapi-project/data/

# JSON runtime files
*_runtime_fixed.json

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

